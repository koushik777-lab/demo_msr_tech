# ==============================================================================
# SMR TECH HUB / SITECRAFT — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production values
# ==============================================================================

# --- DATABASE CONFIGURATION ---
MONGO_URL=mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
DB_NAME=sitecraft

# --- SECURITY & AUTHENTICATION (JWT) ---
JWT_SECRET=your_super_secret_64_char_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- DEMO WORKSPACE CONFIGURATION ---
DEMO_TOKEN_EXPIRE_HOURS=24
DEMO_EMAIL=demo@sitecraft.app

# --- PAYMENT GATEWAY: RAZORPAY ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- ASSET STORAGE ENGINE ---
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- AWS S3 CONFIGURATION (Optional: when STORAGE_PROVIDER=s3) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_production_bucket_name

# --- CORS & SERVER CONFIGURATION ---
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
